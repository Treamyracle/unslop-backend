{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unslop-backend benchmark snapshot schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "target_commit",
    "captured_at",
    "cache_mode",
    "dataset_rows",
    "iterations",
    "warmup_iterations",
    "workloads"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["baseline", "after"] },
    "target_commit": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "minLength": 1 },
    "cache_mode": { "enum": ["cold", "warm"] },
    "dataset_rows": { "type": "integer", "minimum": 1 },
    "iterations": { "type": "integer", "minimum": 1 },
    "warmup_iterations": { "type": "integer", "minimum": 0 },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "workload_id",
          "endpoint_or_task",
          "command",
          "response_status",
          "golden_sha256",
          "queries_per_req",
          "rows_scanned",
          "payload_bytes",
          "p50_ms",
          "p95_ms",
          "p99_ms",
          "heap_delta_kb",
          "explain_plan_type"
        ],
        "additionalProperties": false,
        "properties": {
          "workload_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
          "endpoint_or_task": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "response_status": { "type": "integer", "minimum": 100, "maximum": 599 },
          "golden_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "row_ids_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "contract_projection_approved": { "type": "boolean" },
          "queries_per_req": { "type": "number", "minimum": 0 },
          "rows_scanned": { "type": "number", "minimum": 0 },
          "internal_bytes_read": { "type": "number", "minimum": 0 },
          "payload_bytes": { "type": "number", "minimum": 0 },
          "p50_ms": { "type": "number", "minimum": 0 },
          "p95_ms": { "type": "number", "minimum": 0 },
          "p99_ms": { "type": "number", "minimum": 0 },
          "heap_delta_kb": { "type": "number" },
          "explain_plan_type": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
