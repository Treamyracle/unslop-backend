{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unslop-backend findings report schema",
  "type": "object",
  "required": ["schema_version", "mode", "target_repo", "target_commit", "generated_at", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "mode": { "enum": ["audit", "unslop"] },
    "target_repo": { "type": "string", "minLength": 1 },
    "target_commit": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "unit_id",
          "slop_class",
          "verdict",
          "severity",
          "title",
          "summary",
          "source_trace",
          "skeptic_attempted",
          "skeptic_notes"
        ],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
          "unit_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
          "slop_class": {
            "enum": [
              "n_plus_one_cascade",
              "missing_or_broken_index",
              "overfetch_and_payload_bloat",
              "in_app_aggregation",
              "async_waterfall",
              "connection_and_tx_bloat",
              "memory_and_stream_slop",
              "cold_start_and_bundle_slop"
            ]
          },
          "verdict": { "enum": ["fixed", "confirmed", "needs_validation", "rejected"] },
          "severity": { "enum": ["critical", "high", "medium", "low", null] },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "source_trace": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["file", "line_start", "line_end", "symbol", "role"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 },
                "symbol": { "type": "string", "minLength": 1 },
                "role": { "enum": ["entrypoint", "query_or_io", "aggregation", "fix_site", "guard_or_index"] }
              }
            }
          },
          "skeptic_attempted": { "type": "boolean" },
          "skeptic_notes": { "type": "string", "minLength": 1 },
          "workload_id": { "type": "string", "minLength": 1 },
          "benchmark_command": { "type": "string", "minLength": 1 },
          "baseline_metrics": { "type": "object" },
          "after_metrics": { "type": "object" },
          "golden_match": { "type": "boolean" },
          "improvement_summary": { "type": "string", "minLength": 1 },
          "regression_guard_test": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 },
          "unresolved_fact": { "type": "string", "minLength": 1 },
          "safe_verification_recipe": { "type": "string", "minLength": 1 },
          "rejection_reason": { "type": "string", "minLength": 1 },
          "mitigating_evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
